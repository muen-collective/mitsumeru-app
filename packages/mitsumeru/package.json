{
  "name": "mitsumeru",
  "productName": "Mitsumeru",
  "version": "0.1.9-dev",
  "description": "Mitsumeru — our own Electron shell around a DSH release. Epic 86 Track B.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "harness": "bash scripts/prepare-harness.sh",
    "icon": "bash scripts/make-icon.sh",
    "check:identity": "bash scripts/check-identity.sh",
    "package:dir": "electron-vite build && bash scripts/prepare-harness.sh && bash scripts/check-identity.sh && electron-builder --dir --publish never",
    "package:mac": "electron-vite build && bash scripts/prepare-harness.sh && bash scripts/check-identity.sh && electron-builder --mac --publish never",
    "notarize": "bash scripts/notarize.sh",
    "store:credentials": "bash scripts/store-notary-credentials.sh",
    "verify:release": "bash scripts/verify-release.sh",
    "check:label": "bash scripts/check-version-label.sh",
    "smoke": "bash scripts/smoke.sh",
    "smoke:finder": "bash scripts/smoke-finder.sh",
    "smoke:updater": "bash scripts/smoke-updater.sh",
    "smoke:native": "bash scripts/smoke-native.sh",
    "verify:mount": "bash scripts/verify-mount.sh",
    "verify:distribution": "bash scripts/verify-distribution.sh",
    "brand:probe": "bash scripts/brand-probe.sh",
    "verify:surfaces": "bash scripts/verify-surfaces.sh",
    "capture:live": "bash scripts/capture-live.sh",
    "capture:app": "bash scripts/capture-app.sh",
    "capture:loading": "node_modules/.bin/electron scripts/splash-shot.cjs artifacts/landing",
    "theme:preview": "bash scripts/theme-preview.sh",
    "frameless:check": "node_modules/.bin/electron scripts/frameless-check.cjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.6-alpha.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
