{
  "name": "@muen/dsh-white-label",
  "version": "0.1.0-dev.1",
  "description": "Filesystem-based white-label brand plugin for DeepSeek Harness — reads brand files from <DSH_HOME>/brand/ and exposes them as a cordis service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
