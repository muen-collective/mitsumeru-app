{
  "name": "@muen/dsh-draw",
  "version": "0.1.0",
  "description": "A board the agent can see: sketch the thing that is too fiddly to describe, and the agent reads it as element summaries rather than as pixels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins",
    "directory": "plugins/dsh-draw"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "verify": "node verify/host.mjs && node verify/client.mjs",
    "verify:host": "node verify/host.mjs",
    "verify:client": "node verify/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
