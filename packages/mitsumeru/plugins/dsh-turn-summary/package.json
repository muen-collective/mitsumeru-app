{
  "name": "@muen/dsh-turn-summary",
  "version": "1.0.2",
  "description": "Kun-style turn summary for the DSH conversation: one muted, localized row per finished turn — 'Processed 1m 26s · 12 steps · Edited 3 files' — that expands into what the turn actually did.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
